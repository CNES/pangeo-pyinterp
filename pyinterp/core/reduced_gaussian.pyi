from collections.abc import Callable, Mapping, Sequence
from typing import Any, Protocol

import numpy as np
from numpy.typing import NDArray

from .config.reduced_gaussian import ReducedGaussian

class _NativeKernel(Protocol):
    @property
    def abi(self) -> str: ...
    @property
    def address(self) -> int: ...

class Mesh:
    def __init__(
        self,
        latitudes: NDArray[np.float64],
        points_per_parallel: NDArray[np.int64],
    ) -> None: ...
    @property
    def latitudes(self) -> NDArray[np.float64]: ...
    @property
    def points_per_parallel(self) -> NDArray[np.int64]: ...
    @property
    def offsets(self) -> NDArray[np.int64]: ...
    @property
    def size(self) -> int: ...
    @property
    def ny(self) -> int: ...
    def locate(
        self, lon: NDArray[np.float64], lat: NDArray[np.float64]
    ) -> tuple[NDArray[np.int64], NDArray[np.float64]]: ...
    def __eq__(self, other: object) -> bool: ...
    def __getstate__(self) -> tuple[Any, ...]: ...
    def __setstate__(self, state: tuple[Any, ...]) -> None: ...

class Zone:
    def __init__(self, mesh: Mesh, ranges: NDArray[np.int64]) -> None: ...
    @staticmethod
    def from_box(
        mesh: Mesh,
        lon_min: float,
        lat_min: float,
        lon_max: float,
        lat_max: float,
    ) -> Zone: ...
    @staticmethod
    def from_points(
        mesh: Mesh,
        lon: NDArray[np.float64],
        lat: NDArray[np.float64],
        num_threads: int = ...,
    ) -> Zone: ...
    @property
    def size(self) -> int: ...
    @property
    def mesh_size(self) -> int: ...
    @property
    def num_ranges(self) -> int: ...
    def ranges(self) -> NDArray[np.int64]: ...
    def indices(self) -> NDArray[np.int64]: ...
    def rows(self, index: NDArray[np.int64]) -> NDArray[np.int64]: ...
    def __eq__(self, other: object) -> bool: ...
    def __getstate__(self) -> tuple[Any, ...]: ...
    def __setstate__(self, state: tuple[Any, ...]) -> None: ...

class Grid:
    def __init__(
        self,
        mesh: Mesh,
        fields: Mapping[str, NDArray[np.float32] | NDArray[np.float64]],
        zone: Zone | None = ...,
        a: NDArray[np.float64] | None = ...,
        b: NDArray[np.float64] | None = ...,
    ) -> None: ...
    @property
    def mesh(self) -> Mesh: ...
    @property
    def zone(self) -> Zone | None: ...
    @property
    def field_names(self) -> list[str]: ...
    @property
    def fields(
        self,
    ) -> dict[str, NDArray[np.float32] | NDArray[np.float64]]: ...
    @property
    def a(self) -> NDArray[np.float64] | None: ...
    @property
    def b(self) -> NDArray[np.float64] | None: ...

class Series:
    def __init__(self, mesh: Mesh) -> None: ...
    def append(self, time: int, grid: Grid) -> None: ...
    def drop_before(self, time: int) -> None: ...
    @property
    def times(self) -> NDArray[np.int64]: ...
    @property
    def mesh(self) -> Mesh: ...
    def __len__(self) -> int: ...

def bracket(
    step_times: NDArray[np.int64],
    time: NDArray[np.int64],
    config: ReducedGaussian,
) -> tuple[NDArray[np.int64], NDArray[np.int64], NDArray[np.float64]]: ...
def interpolate(
    source: Grid | Series,
    lon: NDArray[np.float64],
    lat: NDArray[np.float64],
    time: NDArray[np.int64] | None = ...,
    fields: Sequence[str] | None = ...,
    *,
    config: ReducedGaussian,
) -> dict[str, NDArray[np.float64]]: ...
def apply(
    source: Grid | Series,
    callback: Callable[..., Any] | _NativeKernel,
    lon: NDArray[np.float64],
    lat: NDArray[np.float64],
    time: NDArray[np.int64] | None = ...,
    args: Mapping[str, NDArray[np.float64]] | None = ...,
    fields: Sequence[str] | None = ...,
    n_out: int = ...,
    *,
    config: ReducedGaussian,
) -> NDArray[np.float64]: ...
