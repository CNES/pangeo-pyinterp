from typing import Literal

class ReducedGaussian:
    def __init__(self) -> None: ...
    def with_bounds_error(self, value: bool) -> ReducedGaussian: ...
    def with_num_threads(self, value: int) -> ReducedGaussian: ...
    def with_time_method(
        self, value: Literal["linear", "nearest"]
    ) -> ReducedGaussian: ...
    def with_interval(self, value: int) -> ReducedGaussian: ...
    def with_max_step_gap(self, value: int) -> ReducedGaussian: ...
    def with_blend(
        self, value: Literal["columns", "results"]
    ) -> ReducedGaussian: ...
    def with_chunk_size(self, value: int) -> ReducedGaussian: ...
    @property
    def bounds_error(self) -> bool: ...
    @property
    def num_threads(self) -> int: ...
    @property
    def time_method(self) -> Literal["linear", "nearest"]: ...
    @property
    def interval(self) -> int: ...
    @property
    def max_step_gap(self) -> int: ...
    @property
    def blend(self) -> Literal["columns", "results"]: ...
    @property
    def chunk_size(self) -> int: ...
